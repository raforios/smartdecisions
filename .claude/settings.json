{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath' | { read -r f; case \"$f\" in */services/*.py) cd /Users/rafael/Work/projects/back/SmartBear/app && python3 tools/verification/check_signatures.py \"$f\" | grep -v '^0 signature' || true;; esac; }",
            "timeout": 20,
            "statusMessage": "Revisando firmas..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // empty' | grep -qE '(^|[;&|][[:space:]]*)git commit' || exit 0; cd /Users/rafael/Work/projects/back/SmartBear/app && ../.venv/bin/python tools/verification/pre_commit_check.py",
            "timeout": 900,
            "statusMessage": "Verificando los servicios del commit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/rafael/Work/projects/back/SmartBear/app && ../.venv/bin/python tools/verification/language_gate.py --hook",
            "timeout": 60,
            "statusMessage": "Barrido de idioma (/constitucion)..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
